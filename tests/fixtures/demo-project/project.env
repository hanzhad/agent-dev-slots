PROJECT=demo
DEFAULT_BRANCH=main
SLOT_PORTS="SSH_PORT WEB_PORT"
SLOT_FORBIDDEN_PORTS="1101 1102"
DOCS_REPO_URL=https://example.invalid/demo/demo.docs.git
DOCS_PIN_FILE=docs/.pin
SIGNING_KEY_VOLUME=demo-signing-key
SHARED_CACHE_VOLUME=demo-shared-cache
COMPOSE_DIR=.devcontainer
COMPOSE_FILES=docker-compose.yml
SECRETS_OVERLAY=docker-compose.secrets.yml
SLOT_ENV_KEYS="LOG_LEVEL THEME"
SLOT_ENV_SET="SHARED_DIR=../.local/shared"
SLOT_COPY_FILES=".local/settings.json"
SLOT_MOUNT_DIRS=".local/shared"
