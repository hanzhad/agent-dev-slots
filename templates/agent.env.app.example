# dev-container-engine template: agent.env.example version: 1
# The credential file, App mode (FORGE_AUTH=app). Copy this file to the name
# FORGE_AUTH_FILE gives in project.env (agent.env), fill it in, then: chmod 600 agent.env
# Never commit the filled-in file; this template holds no value and may be shared.
#
# The GitHub App's id, the id of its installation, the app slug and the id of its bot user.
FORGE_APP_ID=
FORGE_APP_INSTALLATION_ID=
FORGE_APP_SLUG=
FORGE_APP_BOT_ID=
# The App's private key (.pem): a path under the projects root, e.g. .devcontainer/app.pem
FORGE_APP_KEY_FILE=
# The repositories the token may touch, separated by spaces.
FORGE_APP_REPOS=
