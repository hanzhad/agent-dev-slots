#!/bin/sh
# Runs the engine's dev-container, which lives in a container, with these arguments.
# Needs docker and sh, nothing else. If the container is not running, says how to start it.
set -eu

name=${DEV_CONTAINER_ENGINE_NAME:-dev-container}

# The command that runs this (scripts/dev-container-global) names itself, so usage
# and next steps say `dev-container`, not this script's path.
if [ -n "${DEV_CONTAINER_CALLER:-}" ]; then
  caller=$DEV_CONTAINER_CALLER
else
  case $0 in
    /*) caller=$0 ;;
    */*) caller=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0") ;;
    *) caller=$(command -v "$0" || echo "$0") ;;
  esac
fi

status=$(docker inspect --format '{{.State.Status}}' "$name" 2>/dev/null) || status=missing

if [ "${1:-}" = "status" ]; then
  is_json=0
  for arg in "$@"; do
    if [ "$arg" = "--json" ]; then is_json=1; fi
  done
  case $status in
    running) ;;
    missing)
      if [ "$is_json" = "1" ]; then
        printf '{"version":1,"engine":"not installed","status":"not installed","slots":[],"cleaners":{},"archives":[]}\n'
      else
        echo "engine: not installed"
      fi
      exit 0 ;;
    *)
      if [ "$is_json" = "1" ]; then
        printf '{"version":1,"engine":"not running","status":"not running","slots":[],"cleaners":{},"archives":[]}\n'
      else
        echo "engine: not running ($status)"
      fi
      exit 0 ;;
  esac
fi

case $status in
  running) ;;
  missing)
    echo "$caller: there is no engine container named '$name'. Install it once with:" >&2
    echo "    scripts/engine install --projects-root <the directory that holds your checkouts>" >&2
    exit 1 ;;
  paused)
    echo "$caller: the engine container '$name' is paused. Resume it with: docker unpause $name" >&2
    exit 1 ;;
  *)
    echo "$caller: the engine container '$name' is $status. Start it with: docker start $name" >&2
    exit 1 ;;
esac

lifeline=0
case ${1:-} in
  acquire | resume)
    lifeline=1
    for ll_arg in "$@"; do
      [ "$ll_arg" != "--" ] || break
      if [ "$ll_arg" = "--help" ]; then
        lifeline=0
        break
      fi
    done
    ;;
  up)
    [ $# -eq 1 ] && lifeline=1
    ;;
esac

tty=
if [ "$lifeline" = "0" ] && [ "${1:-}" != "fs" ] && [ "${1:-}" != "get" ] && [ "${1:-}" != "expose" ] && [ -t 0 ]; then tty=-t; fi
# What the global command found out for `doctor`, passed by name only when it set it.
cli_env=
if [ -n "${DEV_CONTAINER_CLI_STATE+set}" ]; then cli_env="$cli_env -e DEV_CONTAINER_CLI_STATE"; fi
if [ -n "${DEV_CONTAINER_CLI_CLONE+set}" ]; then cli_env="$cli_env -e DEV_CONTAINER_CLI_CLONE"; fi
if [ -n "${DEV_CONTAINER_CLI_FOUND+set}" ]; then cli_env="$cli_env -e DEV_CONTAINER_CLI_FOUND"; fi
if [ "$lifeline" = "1" ]; then
  ll_tmp=${TMPDIR:-/tmp}
  case $ll_tmp in
    /) ll_base=/dev-container-lifeline.$$ ;;
    *) ll_base=${ll_tmp%/}/dev-container-lifeline.$$ ;;
  esac
  ll_dir=
  for ll_n in 0 1 2 3 4; do
    if (umask 077 && mkdir "$ll_base.$ll_n") 2>/dev/null; then
      ll_dir="$ll_base.$ll_n"
      break
    fi
  done
  if [ -z "$ll_dir" ]; then
    echo "$caller: could not create temporary lifeline directory in $ll_tmp" >&2
    exit 1
  fi
  ll_fifo="$ll_dir/fifo"
  if ! (umask 077 && mkfifo -m 600 "$ll_fifo") 2>/dev/null; then
    rm -f "$ll_fifo"
    rmdir "$ll_dir" 2>/dev/null || true
    echo "$caller: could not create lifeline FIFO in $ll_dir" >&2
    exit 1
  fi
  exec 0<>"$ll_fifo"
  rm -f "$ll_fifo"
  rmdir "$ll_dir"
  cli_env="$cli_env -e DEV_CONTAINER_CALLER_LIFELINE=stdin"
fi
here=$(pwd -P)

if [ "${1:-}" = "get" ]; then
  get_passthrough=0
  for get_arg in "$@"; do
    case "$get_arg" in
      --help|--stdout) get_passthrough=1 ;;
    esac
  done
  if [ "$get_passthrough" = "0" ] && [ $# -ge 4 ]; then
    shift
    get_slot=$1
    get_src=$2
    get_dst=$3
    shift 3
    case "$get_src" in -*) get_passthrough=1 ;; esac
    case "$get_dst" in -*) get_passthrough=1 ;; esac
    if [ "$get_passthrough" = "0" ]; then
      if [ -d "$get_dst" ]; then
        echo "$caller get: destination is a directory: $get_dst" >&2
        exit 1
      fi
      get_dir=$(dirname "$get_dst")
      if [ ! -d "$get_dir" ]; then
        echo "$caller get: destination directory does not exist: $get_dir" >&2
        exit 1
      fi
      get_tmp="$get_dst.tmp.$$"
      rm -f "$get_tmp"
      get_rc=0
      if [ -n "${CLAUDE_CODE_HOST_SESSION_ID+set}" ]; then
        # shellcheck disable=SC2086
        docker exec -i $cli_env -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
          -e CLAUDE_CODE_HOST_SESSION_ID "$name" dev-container get "$get_slot" --stdout "$get_src" "$@" >"$get_tmp" || get_rc=$?
      else
        # shellcheck disable=SC2086
        docker exec -i $cli_env -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
          "$name" dev-container get "$get_slot" --stdout "$get_src" "$@" >"$get_tmp" || get_rc=$?
      fi
      if [ "$get_rc" -ne 0 ]; then
        rm -f "$get_tmp"
        exit "$get_rc"
      fi
      if ! mv -f "$get_tmp" "$get_dst"; then
        rm -f "$get_tmp"
        exit 1
      fi
      exit 0
    fi
  fi
fi

if [ "${1:-}" = "expose" ]; then
  exp_help=0
  for exp_arg in "$@"; do
    [ "$exp_arg" = "--help" ] && exp_help=1
  done
  if [ "$exp_help" = "0" ]; then
    shift
    exp_rc=0
    if [ -n "${CLAUDE_CODE_HOST_SESSION_ID+set}" ]; then
      # shellcheck disable=SC2086
      exp_plan=$(docker exec -i $cli_env -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
        -e CLAUDE_CODE_HOST_SESSION_ID "$name" dev-container expose-plan "$@") || exp_rc=$?
    else
      # shellcheck disable=SC2086
      exp_plan=$(docker exec -i $cli_env -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
        "$name" dev-container expose-plan "$@") || exp_rc=$?
    fi
    if [ "$exp_rc" -ne 0 ]; then
      exit "$exp_rc"
    fi
    exp_ssh_port=
    exp_key=
    exp_th=
    exp_tp=
    exp_ports=
    while IFS='=' read -r exp_k exp_v; do
      case "$exp_k" in
        ssh_port) exp_ssh_port=$exp_v ;;
        key) exp_key=$exp_v ;;
        target_host) exp_th=$exp_v ;;
        target_port) exp_tp=$exp_v ;;
        host_port) exp_ports="${exp_ports:+$exp_ports }$exp_v" ;;
      esac
    done <<EOF
$exp_plan
EOF
    if [ -z "$exp_ssh_port" ] || [ -z "$exp_key" ] || [ -z "$exp_th" ] || [ -z "$exp_tp" ] || [ -z "$exp_ports" ]; then
      echo "$caller expose: invalid expose-plan output" >&2
      exit 1
    fi
    for exp_hp in $exp_ports; do
      exp_local_cmd="printf 'EXPOSED http://localhost:%s -> %s:%s\\n' '$exp_hp' '$exp_th' '$exp_tp'"
      exp_ssh_rc=0
      ssh -N \
        -o ExitOnForwardFailure=yes \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o ServerAliveInterval=15 \
        -o PermitLocalCommand=yes \
        -o "LocalCommand=$exp_local_cmd" \
        -L "127.0.0.1:${exp_hp}:${exp_th}:${exp_tp}" \
        -i "$exp_key" \
        -p "$exp_ssh_port" \
        -l node 127.0.0.1 || exp_ssh_rc=$?
      if [ "$exp_ssh_rc" -eq 0 ]; then
        exit 0
      fi
      if [ "$exp_ssh_rc" -eq 130 ] || [ "$exp_ssh_rc" -eq 143 ]; then
        exit "$exp_ssh_rc"
      fi
    done
    echo "$caller expose: could not bind any candidate port for $exp_th:$exp_tp" >&2
    exit 1
  fi
fi

if [ "${1:-}" = "put" ]; then
  if [ "${3:-}" = "--stdin" ]; then
    if [ -n "${CLAUDE_CODE_HOST_SESSION_ID+set}" ]; then
      exec docker exec -i -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
        -e CLAUDE_CODE_HOST_SESSION_ID "$name" dev-container "$@"
    fi
    exec docker exec -i -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
      "$name" dev-container "$@"
  elif [ $# -eq 4 ]; then
    slot="$2"
    src="$3"
    dst="$4"
    if [ ! -e "$src" ]; then
      echo "$caller put: no such file or directory on this host: $src" >&2
      exit 1
    fi
    case "$dst" in
      /*) echo "$caller put: <dst> is relative to the slot's workspace (/workspace), not absolute: $dst" >&2; exit 1 ;;
      ..|../*|*/..|*/../*) echo "$caller put: <dst> must stay inside the slot's workspace: $dst" >&2; exit 1 ;;
    esac
    if [ -n "${CLAUDE_CODE_HOST_SESSION_ID+set}" ]; then
      if [ -d "$src" ]; then
        tar -C "$src" -cf - . | docker exec -i -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
          -e CLAUDE_CODE_HOST_SESSION_ID "$name" dev-container put "$slot" --stdin-tar "$dst"
      else
        docker exec -i -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
          -e CLAUDE_CODE_HOST_SESSION_ID "$name" dev-container put "$slot" --stdin "$dst" <"$src"
      fi
      exit $?
    else
      if [ -d "$src" ]; then
        tar -C "$src" -cf - . | docker exec -i -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
          "$name" dev-container put "$slot" --stdin-tar "$dst"
      else
        docker exec -i -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
          "$name" dev-container put "$slot" --stdin "$dst" <"$src"
      fi
      exit $?
    fi
  fi
fi

if [ -n "${CLAUDE_CODE_HOST_SESSION_ID+set}" ]; then
  # shellcheck disable=SC2086
  exec docker exec -i $tty $cli_env -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
    -e CLAUDE_CODE_HOST_SESSION_ID "$name" dev-container "$@"
fi
# shellcheck disable=SC2086
exec docker exec -i $tty $cli_env -e "DEV_CONTAINER_CALLER_PWD=$here" -e "DEV_CONTAINER_CALLER=$caller" \
  "$name" dev-container "$@"
